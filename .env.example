# Copy to server/.env (or set in your host's environment). Never commit real values.
DATABASE_URL=postgres://wnbsls:change-me@localhost:5432/wnbsls
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Used only by `npm run seed` to create the first administrator.
ADMIN_EMAIL=treasurer@wnbsls.example
ADMIN_PASSWORD=use-a-strong-passphrase-of-12-plus-characters

# Public website address (used in invitation and notification links).
APP_URL=http://localhost:5173
SOCIETY_NAME=West New Britain Savings and Loans Society

# Email (Resend). Leave RESEND_API_KEY empty in development: emails are printed to the console.
RESEND_API_KEY=
MAIL_FROM=WNBSLS <noreply@your-verified-domain.com>
